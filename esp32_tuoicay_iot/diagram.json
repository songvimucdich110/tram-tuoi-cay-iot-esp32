    },
    {
      "type": "wokwi-text",
      "id": "lbl_ldr",
      "top": 95,
      "left": -330,
      "attrs": {
        "text": "2. CAM BIEN ANH SANG LDR (GPIO 25)\nBam vao cam bien keo Lux: Sang(Ngay) / Toi(Dem)"
