      "id": "lbl_soil",
      "top": -55,
      "left": -330,
      "attrs": {
        "text": "1. CAM BIEN DO AM DAT v1.2 (GPIO 34)\nXoay trai = Uot (100%) | Xoay phai = Kho (<40%)"
      }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot_soil",
