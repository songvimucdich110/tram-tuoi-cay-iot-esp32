    {
      "type": "wokwi-text",
      "id": "lbl_btns",
      "top": 355,
      "left": -330,
      "attrs": {
        "text": "4. NUT NHAN VAT LY:\nXanh la (GPIO 14): AUTO/MANUAL (Giu 5s Reset EEPROM)\nXanh duong (GPIO 12): BAT/TAT BOM (Che do MANUAL)"
      }
